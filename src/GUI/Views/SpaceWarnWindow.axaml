<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibProsperoPkg.Gui.Views.SpaceWarnWindow"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, SF Pro Text, Helvetica Neue, sans-serif"
        FontSize="12">
  <StackPanel Margin="18" Spacing="10">
    <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="ContinueButton" MinWidth="120" Click="OnContinue" />
      <Button x:Name="CancelButton" MinWidth="88" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
