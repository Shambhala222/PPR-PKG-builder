<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibProsperoPkg.Gui.Views.DiskFullWindow"
        Width="540"
        SizeToContent="Height"
        CanResize="True"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, SF Pro Text, Helvetica Neue, sans-serif"
        FontSize="12">
  <StackPanel Margin="18" Spacing="10">
    <TextBlock x:Name="PausedText" TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock x:Name="FileLabel" />
    <TextBox x:Name="FilePathBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="44" />
    <TextBlock x:Name="HintText" TextWrapping="Wrap" />
    <TextBlock x:Name="CancelHintText" TextWrapping="Wrap" Opacity="0.75" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="RetryButton" MinWidth="88" Click="OnRetry" />
      <Button x:Name="CancelButton" MinWidth="88" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
